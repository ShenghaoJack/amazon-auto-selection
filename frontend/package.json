  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "7.0.2",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.12"
  }
}
